{
  "name": "DataCo FI20 Dark",
  "dataColors": [
    "#3B82F6","#7C3AED","#22C55E",
    "#F59E0B","#F43F5E","#60A5FA",
    "#A78BFA","#34D399"
  ],
  "background":  "#080C14",
  "foreground":  "#FFFFFF",
  "tableAccent": "#3B82F6",
  "bad":         "#F43F5E",
  "neutral":     "#94A3B8",
  "good":        "#22C55E",
  "maximum":     "#22C55E",
  "center":      "#F59E0B",
  "minimum":     "#F43F5E",
  "null":        "#1E3A5F",
  "visualStyles": {
    "*": {
      "*": {
        "background":   [{"color":{"solid":{"color":"#0F1923"}},"transparency":0}],
        "border":       [{"color":{"solid":{"color":"#1E2D3D"}},"show":true}],
        "title": [{
          "fontColor":  {"solid":{"color":"#60A5FA"}},
          "background": {"solid":{"color":"#0F1923"}},
          "fontSize": 11,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }]
      }
    },
    "card": {
      "*": {
        "calloutValue": [{"fontSize":20,"fontFamily":"Segoe UI Bold","color":{"solid":{"color":"#60A5FA"}}}],
        "label":        [{"fontSize":9,"fontFamily":"Segoe UI","color":{"solid":{"color":"#94A3B8"}}}],
        "background":   [{"color":{"solid":{"color":"#0F1923"}},"transparency":0}]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#1E2D3D"}}}],
        "dataLabels":   [{"color":{"solid":{"color":"#FFFFFF"}},"fontSize":9}]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#1E2D3D"}}}],
        "dataLabels":   [{"color":{"solid":{"color":"#FFFFFF"}},"fontSize":9}]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9}],
        "valueAxis":    [{"labelColor":{"solid":{"color":"#94A3B8"}},"fontSize":9,"gridlineColor":{"solid":{"color":"#1E2D3D"}}}]
      }
    },
    "donutChart": {
      "*": {
        "dataLabels": [{"color":{"solid":{"color":"#FFFFFF"}},"fontSize":9}]
      }
    },
    "slicer": {
      "*": {
        "data":       [{"fontColor":{"solid":{"color":"#FFFFFF"}},"fontSize":10,"fontFamily":"Segoe UI"}],
        "background": [{"color":{"solid":{"color":"#141E2A"}},"transparency":0}]
      }
    },
    "matrix": {
      "*": {
        "columnHeaders": [{"fontColor":{"solid":{"color":"#FFFFFF"}},"backColor":{"solid":{"color":"#141E2A"}},"fontSize":10}],
        "rowHeaders":    [{"fontColor":{"solid":{"color":"#FFFFFF"}},"backColor":{"solid":{"color":"#0F1923"}},"fontSize":10}],
        "values":        [{"fontColor":{"solid":{"color":"#CBD5E1"}},"fontSize":10}]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{"fontColor":{"solid":{"color":"#F43F5E"}},"backColor":{"solid":{"color":"#141E2A"}},"fontSize":10}],
        "values":        [{"fontColor":{"solid":{"color":"#CBD5E1"}},"backColor":{"solid":{"color":"#0F1923"}},"fontSize":10}]
      }
    }
  }
}
